# Copy this file to .env and set the absolute path to the project root.
# src/config.py reads PROJECT_ROOT via python-dotenv (load_dotenv()).
# The actual .env is git-ignored so machine-specific paths are never committed.
#
# Local example (Windows):
#   PROJECT_ROOT=G:\aut\project\fpga_fault_diagnosis
# Local example (Linux/macOS):
#   PROJECT_ROOT=/home/user/fpga_fault_diagnosis
# Kaggle example:
#   PROJECT_ROOT=/kaggle/working/fpga_fault_diagnosis
PROJECT_ROOT=
