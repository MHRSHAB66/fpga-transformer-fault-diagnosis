 "purpose": "Identity of the canonical baseline that every research variant is compared against. Canonical artifacts are read-only for research work.",
 "canonical_contract": {
  "classes": [
   "normal",
   "imbalance",
   "misalignment",
   "bearing_fault"
  ],
  "channels": 8,
  "raw_window_samples": 1024,
  "sample_rate_hz": 50000,
  "window_period_ms": 20.48,
  "tokens_after_on_chip_aggregation": 256,
  "aggregation": "exact 4:1 integer mean (aggregate_round_div)",
  "numeric": "INT10 weights/activations/attention probabilities (signed, qmax 511), Q40 requant",
  "raw_input": "signed 24-bit ADC codes, per-window integer z-score inside the IP (onchip_preprocess.h)",
  "decision": "argmax in FPGA logic (pred_class register); optional temporal vote k in 1..15 (vote overlay)"
 },
 "timing_boundary": "prepared RAM window released every 20.48 ms on CPU1 (SCHED_FIFO 50) -> copy to DMA buffer -> MM2S -> core -> S2MM + class register read; response = done - release; acquisition, SSH/TCP transport and GUI are separate boundaries",
