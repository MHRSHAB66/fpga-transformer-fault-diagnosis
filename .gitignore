# Vivado / Vitis HLS temporary + reproducible build products (regenerate from
# the checked-in Tcl + HLS sources; the canonical evidence is copied under
# artifacts/results/seq256_dma_system_dsp_margin_z7020/).
*.jou
.Xil/
# Root-level Vitis HLS project build dir for the SEQ=256 ingress core.
/seq256_ingress1024_dsp_margin/

# Weekly report build intermediates and duplicate PDF output
/docs/reports/*.aux
/output/pdf/*.aux
/output/pdf/weekly_report_10.pdf

# Preserve selected HLS verification evidence despite the global log ignore
!/artifacts/results/hls_*_csim.log
!/artifacts/results/hls_z7020_q40_bounded_snapshot/transformer_top_csim.log

# Slide handoff ZIP and duplicated assets (regenerate from docs/slide_handoff/)
slide_handoff_package.zip
docs/slide_handoff/presentation_progress.pptx
docs/slide_handoff/*.json

# Overlay / bitstream synthesis binaries (large/binary). Recorded by path + size
# + SHA-256 in artifacts/manifests/artifact_manifest.json instead of committed;
# the canonical copies live on the board and in the local (untracked) bundles.
*.bit
*.xsa

# Multi-GB exported FPGA test-set inputs (regenerate via tools/export_fpga_testset.py).
# The small evidence (labels/pred/metrics/logs) in the same dir IS committed.
artifacts/results/fpga_fulltest_*/fpga_testset_in.*

# Intermediate HLS optimization-sweep synthesis REPORT dumps (regenerate from the
# checked-in Tcl + HLS sources). The small top-level hls_*.json / hls_*.png
# summaries and the canonical seq256_dma_system* evidence dirs are kept.
artifacts/results/hls_rt_*/
artifacts/results/hls_rt3a_kv2/
artifacts/results/hls_rt5_splitbuf/
artifacts/results/hls_z7010_opt_*/
artifacts/results/hls_z7020_opt_*/

# Root-level Vitis HLS project build dir for the argmax (on-FPGA class) variant.
/seq256_ingress1024_dsp_margin_argmax/

# Bulky raw per-window dumps (> 2.5 MB each) from the 2026-10-22..24 board runs.
# Their summaries and verification JSON are committed; the raw files are recorded
# by SHA-256 in artifacts/manifests/artifact_manifest.json and kept in the
# off-repo backup.
artifacts/results/fpga_argmax_fulltest_20261023/live_frames.*
artifacts/results/fpga_timing_20261023/**/workload.out
artifacts/results/fpga_timing_20261023/**/workload_stream.out
artifacts/results/fpga_timing_20261023/**/pc_rx.tsv
artifacts/results/e2e_demo_gui_20261024_231859/pc_evidence.json
artifacts/results/e2e_demo_gui_20261024_231859/frames.tsv
artifacts/results/e2e_demo_gui_20261024_233000/pc_evidence.json
artifacts/results/e2e_demo_gui_20261024_233000/frames.tsv

# Board firmware / kernel binaries (vendor boot images, QSPI dumps, the
# PREEMPT_RT candidate build). Hashes and procedures are committed; the binaries
# stay in the off-repo backup.
artifacts/rollback/**/*.bin
artifacts/rollback/**/*.BIN
artifacts/rollback/**/*.ub
artifacts/rollback/**/*.tar
artifacts/preempt_rt_candidate_20261024/*.ub
artifacts/preempt_rt_candidate_20261024/*.tar.gz

# RAM demo input sets (binary, regenerate via tools/make_ram_demo_set.py; the
# provenance.json pins the set's SHA-256).
artifacts/ram_demo_sets/*/set.i32

# Root-level Vitis HLS project build dir for the raw-input (on-FPGA preprocessing) variant.
/seq256_raw1024_dsp_margin_argmax/
# Multi-GB raw-sample test input for the on-FPGA preprocessing core (tools/export_fpga_testset_raw.py).
artifacts/results/fpga_rawinput_testset_*/fpga_testset_raw.*
# Per-window board output of the raw-core full test (6 MB; pred.txt and the check JSON are committed)
artifacts/results/raw_core_board_fulltest_*/fulltest.out
# Root-level Vitis HLS project build dir for the raw-input + temporal vote variant.
/seq256_rawvote1024/
# Root-level Vitis HLS project build dir for the noise-augmented vote variant (paper study).
/seq256_rawvote1024_na/
# Perturbed copies of the raw test input for board runs (tools/make_noisy_testset.py; ~2.4 GB each).
artifacts/results/noisy_testsets_*/*.i32.gz
# Root-level Vitis HLS project of the research A05 divq9 core.
/seq256_divq9/
artifacts/research/*/*/bitstream/*.bit
artifacts/research/*/*/bitstream/*.xsa
# Root-level Vitis HLS project of the research B02 integrity core.
/seq256_b02/
# Raw-domain validation windows for research (Q01; tools/export_fpga_testset_raw.py --split val).
artifacts/results/fpga_rawinput_valset_*/fpga_valset_raw.*
# Root-level Vitis HLS project of the research B03 injection core.
/seq256_b03/
