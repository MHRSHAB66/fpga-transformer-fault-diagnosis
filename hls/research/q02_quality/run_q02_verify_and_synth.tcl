# Q02 (research, 2026-11-14): canonical raw-input argmax core + input-quality / decision-status
# metadata registers (transformer_top_seq256_raw1024_q02_argmax.cpp, generated by make_q02_top.py).
# C-simulation must reproduce the CANONICAL golden_raw1024_argmax set exactly (logits + class).
# Usage (from the repository root): vitis_hls -f hls/research/q02_quality/run_q02_verify_and_synth.tcl
set here [file dirname [file normalize [info script]]]
set vitis [file normalize [file join $here .. .. f1_int10_seq256 vitis]]
set golden [file normalize [file join $vitis .. golden_raw1024_argmax]]
set part "xc7z020clg400-1"
set clk 10
open_project -reset seq256_q02
set_top transformer_top
add_files [file join $here transformer_top_seq256_raw1024_q02_argmax.cpp] \
    -cflags "-DHLS_USE_AP_INT -I$here -I$vitis"
add_files -tb [file join $here testbench_q02.cpp]
add_files -tb $golden
open_solution -reset sol1 -flow_target vivado
set_part $part
create_clock -period $clk -name default
csim_design -O -argv $golden
csynth_design
export_design -format ip_catalog
exit
