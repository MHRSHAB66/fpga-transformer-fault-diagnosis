# A06 combined finalist (research, 2026-11-13): raw-input argmax core with unsigned
# 8-bit attention probabilities + exact 8-bit divider (transformer_top_seq256_raw1024_p8u_argmax.cpp,
# generated by make_a06_top.py). C-simulation must reproduce its OWN golden set
# (artifacts/research/A06_20261113/golden_raw1024_p8u, research p8u reference). Separate project.
# Usage (from the repository root): vitis_hls -f hls/research/a04_softmax_div/run_a06_verify_and_synth.tcl
set here [file dirname [file normalize [info script]]]
set vitis [file normalize [file join $here .. .. f1_int10_seq256 vitis]]
set golden [file normalize [file join $here .. .. .. artifacts research A06_20261113 golden_raw1024_p8u]]
set part "xc7z020clg400-1"
set clk 10
open_project -reset seq256_p8u
set_top transformer_top
add_files [file join $here transformer_top_seq256_raw1024_p8u_argmax.cpp] \
    -cflags "-DHLS_USE_AP_INT -I$here -I$vitis"
add_files -tb [file join $vitis testbench_ingress1024_argmax.cpp]
add_files -tb $golden
open_solution -reset sol1 -flow_target vivado
set_part $part
create_clock -period $clk -name default
csim_design -O -argv $golden
csynth_design
export_design -format ip_catalog
exit
